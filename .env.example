# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
NEXT_PUBLIC_CHATKIT_WORKFLOW_ID=your-default-workflow-id

# Workflow IDs for different agents
NEXT_PUBLIC_GENERAL_ID=your-general-workflow-id
NEXT_PUBLIC_N8N_ID=your-n8n-workflow-id
NEXT_PUBLIC_DESPACHOS_ID=your-despachos-workflow-id
NEXT_PUBLIC_EXPERTO_TRIBUTOS_ID=your-tributos-workflow-id
NEXT_PUBLIC_EXPERTO_BOICAC_ID=your-boicac-workflow-id

# Supabase Configuration
# Obtén estos valores de tu proyecto en https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
